{
  "openapi": "3.0.3",
  "info": {
    "title": "Bearer Multipart Enum API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://example.com/api"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/upload": {
      "post": {
        "operationId": "uploadDocument",
        "tags": [
          "docs"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/UploadRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "DocumentKind": {
        "type": "string",
        "enum": [
          "invoice",
          "receipt",
          "contract"
        ]
      },
      "UploadRequest": {
        "type": "object",
        "required": [
          "file",
          "kind"
        ],
        "properties": {
          "file": {
            "type": "string",
            "format": "binary"
          },
          "kind": {
            "$ref": "#/components/schemas/DocumentKind"
          }
        }
      }
    }
  }
}
